# ---------------------------------------------------------------------------
# Fantasy Draft Workstation — environment
# Copy to `.env` and fill in. Only DATABASE_URL is required to boot.
# ---------------------------------------------------------------------------

# SQLite file. Lives in prisma/ so it is easy to back up / copy before a draft.
DATABASE_URL="file:./dev.db"

# Your Sleeper league id for the current season.
# Find it in the Sleeper web app URL: https://sleeper.com/leagues/<THIS_NUMBER>/team
SLEEPER_LEAGUE_ID=""

# Your Sleeper username (used to figure out which roster is yours).
SLEEPER_USERNAME=""

# Optional: pin the season. Defaults to the current NFL state season from Sleeper.
SEASON=""

# Optional: Anthropic API key enables AI-generated analytical summaries.
# Without it the app still works; summary panels show a "not configured" note.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Live draft polling interval in milliseconds. 2000-3000 is plenty for Sleeper.
DRAFT_POLL_MS="2500"
